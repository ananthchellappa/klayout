<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>Layout-XL kit: command palette (Ctrl+Shift+P), voice commands (tap Ctrl+Shift), gf180 vias</description>
 <version>0.1</version>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text># Layout XL: the command palette (Ctrl+Shift+P), voice (tap Ctrl+Shift) and the
# gf180mcu_vias library (vias for the wire tool's "O" / via up / via down).
# Commands are parsed by layout_xl.commands, the same grammar for typing and voice.

import pya
from layout_xl import palette, vias, voice

vias.register()


def _install():
  mw = pya.MainWindow.instance()
  if mw is None:
    return
  menu = mw.menu()
  if not menu.is_valid("layout_xl_menu"):
    menu.insert_menu("help_menu", "layout_xl_menu", "Layout XL")
  if not menu.is_valid("layout_xl_menu.palette"):
    action = pya.Action()
    action.title = "Command Palette..."
    action.default_shortcut = "Ctrl+Shift+P"
    action.on_triggered += palette.show
    menu.insert_item("layout_xl_menu.end", "palette", action)
    globals()["_layout_xl_palette_action"] = action   # the menu doesn't own Python actions
  if not menu.is_valid("layout_xl_menu.voice"):
    action = pya.Action()
    action.title = "Voice Command (tap Ctrl+Shift)"
    action.on_triggered += lambda: voice.install().tap()
    menu.insert_item("layout_xl_menu.end", "voice", action)
    globals()["_layout_xl_voice_action"] = action
  voice.install()        # Ctrl+Shift tap; starts the recogniser if voice/setup.sh was run


_install()
</text>
</klayout-macro>
